# Copy this file to .env and fill in your values:
#     cp .env.example .env
# .env is listed in .gitignore, so it never gets committed. This example file does.
# Put each value on its own line. Wrap a value in quotes if it starts or ends with a space.

# OpenAI API key, used by host/room_agent.py
OPENAI_API_KEY=your-openai-api-key

# The WiFi network the ESP32 boards join (must be 2.4 GHz)
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

# IP address of the computer running Mosquitto. On a Mac: ipconfig getifaddr en0
MQTT_HOST=your-mac-ip

# Password for uploading firmware to the boards over WiFi
OTA_PASSWORD=your-ota-password
